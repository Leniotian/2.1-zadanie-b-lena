<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette Colors -->
    <Color x:Key="ForestDarkBgColor">#101A10</Color>
    <Color x:Key="ForestCardBgColor">#1A2C1A</Color>
    <Color x:Key="ForestCardBorderColor">#2E4D2E</Color>
    <Color x:Key="ForestHeaderBgColor">#152415</Color>
    <Color x:Key="ForestGreenColor">#43A047</Color>
    <Color x:Key="ForestGreenLightColor">#66BB6A</Color>
    <Color x:Key="ForestGreenDarkColor">#2E7D32</Color>
    <Color x:Key="ForestGoldColor">#FFB300</Color>
    <Color x:Key="ForestWoodColor">#5D4037</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="ForestDarkBgBrush" Color="{StaticResource ForestDarkBgColor}"/>
    <SolidColorBrush x:Key="ForestCardBgBrush" Color="{StaticResource ForestCardBgColor}"/>
    <SolidColorBrush x:Key="ForestCardBorderBrush" Color="{StaticResource ForestCardBorderColor}"/>
    <SolidColorBrush x:Key="ForestHeaderBgBrush" Color="{StaticResource ForestHeaderBgColor}"/>
    <SolidColorBrush x:Key="ForestGreenBrush" Color="{StaticResource ForestGreenColor}"/>
    <SolidColorBrush x:Key="ForestGreenLightBrush" Color="{StaticResource ForestGreenLightColor}"/>
    <SolidColorBrush x:Key="ForestGreenDarkBrush" Color="{StaticResource ForestGreenDarkColor}"/>
    <SolidColorBrush x:Key="ForestGoldBrush" Color="{StaticResource ForestGoldColor}"/>
    <SolidColorBrush x:Key="ForestWoodBrush" Color="{StaticResource ForestWoodColor}"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDF7ED"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#A5D6A7"/>
    <SolidColorBrush x:Key="TextGoldBrush" Color="#FFE082"/>

    <!-- Primary Button Style -->
    <Style x:Key="ForestPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ForestGreenBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ForestGreenLightBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ForestGreenLightBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#C8E6C9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ForestGreenDarkBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Secondary Button Style -->
    <Style x:Key="ForestSecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#223922"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource ForestCardBorderBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2E4C2E"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ForestGreenLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#172717"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Action Button Style -->
    <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#1E331E"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2E4C2E"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#2B472B"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ForestGreenLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#142314"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Mode Selector RadioButton / Pill Style -->
    <Style x:Key="ForestPillRadioStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="#1E321E"/>
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="#2F4C2F"/>
        <Setter Property="Margin" Value="3,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource ForestGreenLightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="{StaticResource ForestGreenBrush}"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#A5D6A7"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card Container Style -->
    <Style x:Key="ForestCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ForestCardBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource ForestCardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
